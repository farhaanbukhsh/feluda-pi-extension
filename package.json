{
  "name": "feluda-pi-extension",
  "version": "0.1.0",
  "description": "Pi package that exposes Feluda license analysis as a skill and custom tools.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhaanbukhsh/feluda-pi-extension.git"
  },
  "bugs": {
    "url": "https://github.com/farhaanbukhsh/feluda-pi-extension/issues"
  },
  "homepage": "https://github.com/farhaanbukhsh/feluda-pi-extension#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["pi-package", "pi", "feluda", "license", "sbom", "compliance"],
  "files": [
    "extensions",
    "skills",
    "README.md"
  ],
  "pi": {
    "extensions": ["./extensions/feluda/index.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0",
    "typebox": "*",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  }
}